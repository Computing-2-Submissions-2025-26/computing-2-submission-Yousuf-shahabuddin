{
    "tags": {
        "allowUnknownTags": true,
        "dictionaries": ["jsdoc", "closure"]
    },
    "source": {
        "include": [
            "web-app/Azul.js"
        ]
    },
    "templates": {
        "cleverLinks": true,
        "monospaceLinks": true
    },
    "opts": {
        "destination": "docs",
        "encoding": "utf8",
        "private": true,
        "recurse": true,
        "template": "node_modules/docdash"
    }
}
